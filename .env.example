# Local development only (`npm start`). On Vercel, set these in the project's
# Environment Variables instead; the Gateway authenticates with the project's OIDC token.

# Vercel AI Gateway key (Vercel dashboard > AI Gateway > API Keys). Optional on Vercel.
# Locally you can instead run `vercel env pull` to get a short-lived VERCEL_OIDC_TOKEN.
AI_GATEWAY_API_KEY=

# xAI Grok models, as listed by the Gateway (https://ai-gateway.vercel.sh/v1/models).
SEAT_MODEL=spacexai/grok-4.20-non-reasoning
CHAIR_MODEL=spacexai/grok-4.3

# Set to 1 to run the whole council on canned answers (no Gateway calls), for testing.
MOCK_MODEL=
